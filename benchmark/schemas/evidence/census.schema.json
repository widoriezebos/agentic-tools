{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completedAt": {
      "format": "date-time",
      "type": "string"
    },
    "completedAtEpoch": {
      "type": "integer"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "ANNOUNCED": {
          "minimum": 0,
          "type": "integer"
        },
        "CUSTODY": {
          "minimum": 0,
          "type": "integer"
        },
        "UNTRACKED": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "CUSTODY",
        "ANNOUNCED",
        "UNTRACKED"
      ],
      "type": "object"
    },
    "diagnostics": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "durationMs": {
      "minimum": 0,
      "type": "integer"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "fingerprint": {
      "type": "string"
    },
    "generation": {
      "type": [
        "integer",
        "null"
      ]
    },
    "intervalSec": {
      "minimum": 1,
      "type": "integer"
    },
    "inventory": {
      "type": "array"
    },
    "schemaVersion": {
      "enum": [
        1,
        2
      ],
      "type": "integer"
    },
    "stateDigest": {
      "type": [
        "string",
        "null"
      ]
    },
    "verdict": {
      "enum": [
        "SUCCESS",
        "CENSUS-FAILED"
      ]
    },
    "writer": {
      "type": "string"
    },
    "scanSeq": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schemaVersion",
    "writer",
    "verdict",
    "completedAt",
    "completedAtEpoch",
    "durationMs",
    "intervalSec",
    "fingerprint",
    "counts",
    "inventory",
    "diagnostics",
    "errors"
  ],
  "title": "Pinned process census evidence",
  "type": "object"
}
