{
  "$comment": "metasystem.version=2",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "claimed": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "sessionId",
        "model"
      ],
      "type": "object"
    },
    "classifications": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "level": {
            "enum": [
              "ran",
              "read",
              "inferred"
            ]
          },
          "observed": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "observed",
          "level"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "frozenFrame": {
      "type": "string"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "jobId": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "model": {
      "additionalProperties": false,
      "properties": {
        "effective": {
          "type": "string"
        },
        "requested": {
          "type": "string"
        }
      },
      "required": [
        "requested",
        "effective"
      ],
      "type": "object"
    },
    "round": {
      "type": "integer"
    },
    "runtime": {
      "type": "string"
    },
    "schemaVersion": {
      "enum": [
        2
      ],
      "type": "integer"
    },
    "sessionId": {
      "type": "string"
    },
    "stopLoss": {
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "type": [
            "string",
            "null"
          ]
        },
        "triggered": {
          "type": "boolean"
        }
      },
      "required": [
        "triggered",
        "trigger"
      ],
      "type": "object"
    },
    "theories": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidenceAgainst": {
            "type": "string"
          },
          "evidenceFor": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          }
        },
        "required": [
          "statement",
          "evidenceFor",
          "evidenceAgainst"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "claimed",
    "jobId",
    "round",
    "runtime",
    "sessionId",
    "model",
    "evidence",
    "gaps",
    "mode",
    "frozenFrame",
    "theories",
    "classifications",
    "stopLoss"
  ],
  "title": "Investigator return version 2",
  "type": "object"
}
