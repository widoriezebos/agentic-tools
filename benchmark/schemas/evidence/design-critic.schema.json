{
  "$comment": "metasystem.version=1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "chainClosed": {
      "type": "boolean"
    },
    "claimed": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "sessionId",
        "model"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "level": {
            "enum": [
              "ran",
              "read",
              "inferred"
            ]
          },
          "observed": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "observed",
          "level"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "material": {
            "type": "boolean"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "id",
          "severity",
          "material",
          "claim",
          "evidence"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "jobId": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "model": {
      "additionalProperties": false,
      "properties": {
        "effective": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested": {
          "type": "string"
        }
      },
      "required": [
        "requested",
        "effective"
      ],
      "type": "object"
    },
    "reviewedCommit": {
      "type": [
        "string",
        "null"
      ]
    },
    "round": {
      "type": "integer"
    },
    "runtime": {
      "type": "string"
    },
    "schemaVersion": {
      "enum": [
        1,
        2
      ],
      "type": "integer"
    },
    "sessionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "verdictMaterialCount": {
      "type": "integer"
    }
  },
  "required": [
    "jobId",
    "round",
    "runtime",
    "sessionId",
    "model",
    "evidence",
    "gaps",
    "mode",
    "findings",
    "verdictMaterialCount"
  ],
  "title": "Design critic return",
  "type": "object"
}
