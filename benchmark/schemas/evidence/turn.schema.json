{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned mission turn evidence fields",
  "type": "object",
  "required": [
    "cycle", "endedAt", "error", "missionId", "model", "outcome", "result",
    "runtime", "startedAt", "status", "turnCapMin", "turnId"
  ],
  "properties": {
    "cycle": {"type": "integer", "minimum": 1},
    "endedAt": {"type": ["string", "null"]},
    "error": {"type": ["string", "null"]},
    "missionId": {"type": "string"},
    "model": {"type": "string"},
    "outcome": {"type": "string"},
    "result": {"type": ["object", "null"]},
    "runtime": {"type": "string"},
    "startedAt": {"type": "string", "format": "date-time"},
    "status": {"type": "string"},
    "turnCapMin": {"type": "integer", "minimum": 1},
    "turnId": {"type": "string"}
  }
}
