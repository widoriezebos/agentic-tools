{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned job-record evidence fields",
  "type": "object",
  "required": [
    "jobId", "role", "mission", "runtime", "round", "parentJob", "status",
    "error", "capMin", "sessionId", "requestedModel", "effectiveModel",
    "startedAt", "endedAt", "usage", "chainClosed"
  ],
  "properties": {
    "jobId": {"type": "string"},
    "role": {"type": "string"},
    "mission": {"type": ["string", "null"]},
    "runtime": {"type": "string"},
    "round": {"type": "integer", "minimum": 1},
    "parentJob": {"type": ["string", "null"]},
    "status": {"type": "string"},
    "error": {"type": ["string", "null"]},
    "capMin": {"type": "integer", "minimum": 1},
    "sessionId": {"type": ["string", "null"]},
    "requestedModel": {"type": "string"},
    "effectiveModel": {"type": ["string", "null"]},
    "startedAt": {"type": "string", "format": "date-time"},
    "endedAt": {"type": ["string", "null"]},
    "usage": {"type": ["object", "null"]},
    "chainClosed": {"type": "boolean"}
  }
}
