{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cohort record (schema 2)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "cohortId",
    "caseId",
    "caseVersion",
    "caseTree",
    "configId",
    "configVersion",
    "configTree",
    "measuringKitVersion",
    "repetitionCount",
    "machineFingerprint",
    "roster",
    "fences",
    "candidateSha",
    "measuringMetasystemSha",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "cohortId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "caseVersion": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,3}$",
      "maxLength": 16
    },
    "caseTree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "configId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "configVersion": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,3}$",
      "maxLength": 16
    },
    "configTree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "legacyId": {
      "type": "string"
    },
    "legacyVersionLabel": {
      "type": "string"
    },
    "measuringKitVersion": {
      "type": "string"
    },
    "proposalId": {
      "type": [
        "string",
        "null"
      ]
    },
    "repetitionCount": {
      "type": "integer",
      "minimum": 1
    },
    "machineFingerprint": {
      "type": "object"
    },
    "roster": {
      "type": "object"
    },
    "fences": {
      "type": "object"
    },
    "candidateSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "measuringMetasystemSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "createdAt": {
      "type": "string"
    }
  }
}
