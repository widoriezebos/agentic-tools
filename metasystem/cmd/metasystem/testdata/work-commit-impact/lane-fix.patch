+func TestAdmitDeclarationBaselineRequiresFullExceptCarry(t *testing.T) {
+	t.Parallel()
+	for _, state := range []string{"ordinary missing full", "carry missing full", "ordinary complete", "carry missing cheap"} {
+		t.Run(state, func(t *testing.T) {
+			t.Parallel()
+			root := t.TempDir()
+			snapshot := Declaration{Commit: "subject", Values: [4]string{"printf cheap", "true", "15", ""}}
+			if state == "ordinary complete" {
+				snapshot.Values[3] = "printf full"
+			}
+			if state == "carry missing cheap" {
+				snapshot.Values[0] = ""
+			}
+			baseline := declarationReference{Goal: "goal", Seed: "main", Snapshot: snapshot}
+			body, err := json.Marshal(baseline)
+			if err != nil {
+				t.Fatal(err)
+			}
+			path := filepath.Join(root, "process", fmt.Sprintf("declaration-%x.json", sha256.Sum256([]byte(baseline.Goal))))
+			if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(path, body, 0600); err != nil {
+				t.Fatal(err)
+			}
+			published := false
+			c := DeclarationAdmission{Check: Check{Root: root, ProcessAct: ProcessAct{Goal: baseline.Goal}},
+				Source:  func() (Declaration, Declaration, Declaration, error) { return snapshot, snapshot, snapshot, nil },
+				Recheck: func() error { return nil }, Publish: func(ProcessAct) error { published = true; return nil }}
+			if strings.HasPrefix(state, "carry") {
+				c.Subject = snapshot.Commit
+			}
+			act, err := AdmitDeclaration(c)
+			if state == "ordinary missing full" || state == "carry missing cheap" {
+				if err == nil || !strings.Contains(err.Error(), "baseline is unavailable") || published {
+					t.Fatalf("damaged baseline was admitted: %+v %v published=%v", act, err, published)
+				}
+				after, err := os.ReadFile(path)
+				if err != nil || string(after) != string(body) {
+					t.Fatalf("damaged baseline was changed: %s %v", after, err)
+				}
+			} else if err != nil || act.Status != "unchanged" || !published {
+				t.Fatalf("lawful baseline was held: %+v %v published=%v", act, err, published)
+			}
+		})
+	}
+}
