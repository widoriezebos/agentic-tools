{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "metasystem.version=1",
  "title": "Steward continuation return",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "round",
    "runtime",
    "sessionId",
    "model",
    "goal",
    "outcome",
    "landed",
    "remaining",
    "receipts",
    "evidence",
    "gaps",
    "mode"
  ],
  "properties": {
    "jobId": {
      "type": "string"
    },
    "round": {
      "type": "integer"
    },
    "runtime": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "effective"
      ],
      "properties": {
        "requested": {
          "type": "string"
        },
        "effective": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "goal": {
      "type": "string",
      "description": "the open goal this continuation served"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "continued",
        "yielded-to-live-worker",
        "blocked"
      ],
      "description": "continued = work advanced; yielded = fresh progress by another worker was found and respected; blocked = a named blocker stops the goal"
    },
    "landed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "commits or milestones landed, empty when none"
    },
    "remaining": {
      "type": "string",
      "description": "what still stands, or a named blocker; empty only with a concluded goal"
    },
    "receipts": {
      "type": "integer",
      "description": "receipt lines this continuation wrote"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "observed",
          "level"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "level": {
            "enum": [
              "ran",
              "read",
              "inferred"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "type": "string"
    }
  }
}
