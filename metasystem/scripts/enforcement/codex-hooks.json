{
  "description": "Repository supervision and end-of-turn visibility for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/agents/supervision-hook.sh codex start",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/agents/supervision-hook.sh codex stop",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/agents/supervision-hook.sh codex end",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
