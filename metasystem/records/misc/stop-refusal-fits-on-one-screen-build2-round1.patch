+
+func TestReportBoundMessageUsesStopDisplayBound(t *testing.T) {
+	output, code := captureStdout(t, func() int {
+		return runReportBoundMessage([]string{"--text", "ALLOW\n" + strings.Repeat("detail", 1000)})
+	})
+	if code != 0 {
+		t.Fatalf("report bound-message exited %d", code)
+	}
+	output = strings.TrimSuffix(output, "\n")
+	if len([]rune(output)) > goal.TurnVerdictDisplayRuneLimit {
+		t.Fatalf("bounded message has %d runes", len([]rune(output)))
+	}
+	if !strings.HasPrefix(output, "ALLOW\n") || !strings.Contains(output, "system message trimmed") {
+		t.Fatalf("bounded message lost its leading line or trim notice: %q", output)
+	}
+}
