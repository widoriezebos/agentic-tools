+// HookPreviewLine keeps the hook-visible health view actionable and short:
+// non-alive checks retain their reasons and remedies, while alive checks are
+// represented by one aggregate count.
+func (v HealthVerdict) HookPreviewLine() string {
+	items := make([]string, 0, len(v.Roles)+1)
+	alive := 0
+	for _, role := range v.Roles {
+		if role.Status == HealthAlive {
+			alive++
+			continue
+		}
+		item := fmt.Sprintf("%s=%s", role.Role, role.Status)
+		if role.Reason != "" {
+			item += " (" + role.Reason
+			if role.Remedy != "" {
+				item += "; remedy: " + role.Remedy
+			}
+			item += ")"
+		}
+		if role.ConsecutiveFailures > 0 {
+			item += fmt.Sprintf(" [failure %d/%d; %s]", role.ConsecutiveFailures, healthFailureLimit, strings.ToLower(strings.ReplaceAll(role.FailureEscalation, "_", " ")))
+		}
+		items = append(items, item)
+	}
+	items = append(items, fmt.Sprintf("%d checks alive", alive))
+	return v.linePrefix() + v.Aggregate + " — " + strings.Join(items, "; ")
+}
