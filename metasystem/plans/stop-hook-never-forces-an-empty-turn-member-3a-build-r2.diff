+			t.Fatalf("queue incident: %+v", got)
+		}
+		ledgerPath := stopIncidentLedgerPath(root, now)
+		if err := os.Remove(ledgerPath); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Mkdir(ledgerPath, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		calls := 0
+		sender := func(_, message string) error {
+			calls++
+			if calls > 1 || !strings.Contains(message, incident.Cause) {
+				t.Fatalf("unexpected delivery call %d with message %q", calls, message)
+			}
+			return nil
+		}
+		if delivered, err := deliverPending(root, sender); err == nil || delivered != 0 {
+			t.Fatalf("ledger failure delivered=%d err=%v, want unconfirmed", delivered, err)
+		}
+		pending, err := PendingNotifications(root)
+		if err != nil || len(pending) != 1 || pending[0].DeliveredAt == "" || calls != 1 {
+			t.Fatalf("stamped pending=%+v calls=%d err=%v", pending, calls, err)
+		}
+		if err := os.Remove(ledgerPath); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(ledgerPath, []byte(fmt.Sprintf("drain-start %d\n", now.Unix())), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		if delivered, err := deliverPending(root, sender); err != nil || delivered != 1 || calls != 1 {
+			t.Fatalf("stamped retry delivered=%d calls=%d err=%v, want removal without redelivery", delivered, calls, err)
+		}
+	})
+}
