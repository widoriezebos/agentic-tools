diff --git a/metasystem/internal/stopincident/stopincident.go b/metasystem/internal/stopincident/stopincident.go
new file mode 100644
index 000000000..89a62349c
--- /dev/null
+++ b/metasystem/internal/stopincident/stopincident.go
@@ -0,0 +1,178 @@
+// Package stopincident owns the stable identity and on-disk source formats for
+// infrastructure failures that allowed a Stop request to finish.
+package stopincident
+
+import (
+	"bufio"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const (
+	SourceHookLog       = "hook-log"
+	SourceRefusalRecord = "refusal-record"
+)
+
+// Incident is the shared coordinate set carried by the hook log and refusal
+// records. Outcome describes the latest observation but is not part of the
+// identity, so retrying one deadline cannot create another notification.
+type Incident struct {
+	Class       string
+	Cause       string
+	Component   string
+	Generation  string
+	DeadlineEnd int64
+	Outcome     string
+	Source      string
+}
+
+// Identity returns the first 16 hexadecimal characters of the coordinate
+// digest shared by every source.
+func Identity(incident Incident) string {
+	coordinates := strings.Join([]string{
+		incident.Class,
+		incident.Cause,
+		incident.Component,
+		incident.Generation,
+		strconv.FormatInt(incident.DeadlineEnd, 10),
+	}, "\x00")
+	sum := sha256.Sum256([]byte(coordinates))
+	return hex.EncodeToString(sum[:8])
+}
+
+// ReadHookLog returns infrastructure incidents and delivered acknowledgments.
+// Unknown and incomplete lines remain available to their existing consumers
+// and are skipped here.
+func ReadHookLog(path string) ([]Incident, map[string]bool, error) {
+	file, err := os.Open(path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return []Incident{}, map[string]bool{}, nil
+		}
+		return nil, nil, err
+	}
+	defer file.Close()
+
+	incidents := []Incident{}
+	acked := map[string]bool{}
+	scanner := bufio.NewScanner(file)
+	for scanner.Scan() {
+		fields := strings.Fields(scanner.Text())
+		switch {
+		case len(fields) == 7 && fields[0] == "stop-condition" && fields[1] == "infrastructure":
+			deadlineEnd, parseErr := strconv.ParseInt(fields[5], 10, 64)
+			if parseErr != nil {
+				continue
+			}
+			incidents = append(incidents, Incident{
+				Class: fields[1], Cause: fields[2], Component: fields[3], Generation: fields[4],
+				DeadlineEnd: deadlineEnd, Outcome: fields[6], Source: SourceHookLog,
+			})
+		case len(fields) == 3 && fields[0] == "stop-incident-ack" && validIdentity(fields[1]):
+			if _, parseErr := strconv.ParseInt(fields[2], 10, 64); parseErr == nil {
+				acked[fields[1]] = true
+			}
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		return nil, nil, err
+	}
+	return incidents, acked, nil
+}
+
+// AppendAck records that the steward delivered an incident notification.
+func AppendAck(path, identity string, deliveredAt time.Time) error {
+	if !validIdentity(identity) {
+		return fmt.Errorf("stop incident acknowledgment has invalid identity %q", identity)
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return err
+	}
+	file, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o600)
+	if err != nil {
+		return err
+	}
+	if _, err := fmt.Fprintf(file, "stop-incident-ack %s %d\n", identity, deliveredAt.UTC().Unix()); err != nil {
+		_ = file.Close()
+		return err
+	}
+	return file.Close()
+}
+
+type refusalRecord struct {
+	SchemaVersion int                     `json:"schemaVersion"`
+	Causes        map[string]refusalCause `json:"causes"`
+}
+
+type refusalCause struct {
+	Class     string            `json:"class"`
+	Incidents []refusalIncident `json:"incidents"`
+}
+
+type refusalIncident struct {
+	Identity    string `json:"identity"`
+	Cause       string `json:"cause"`
+	Component   string `json:"component"`
+	Generation  string `json:"generation"`
+	DeadlineEnd int64  `json:"deadlineEnd"`
+}
+
+// ReadRefusalRecords returns the incident coordinates retained in version-one
+// records. Causes written before incidents were added remain valid history.
+func ReadRefusalRecords(dir string) ([]Incident, error) {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return []Incident{}, nil
+		}
+		return nil, err
+	}
+	incidents := []Incident{}
+	for _, entry := range entries {
+		if entry.IsDir() || filepath.Ext(entry.Name()) != ".json" {
+			continue
+		}
+		path := filepath.Join(dir, entry.Name())
+		data, err := os.ReadFile(path)
+		if err != nil {
+			return nil, fmt.Errorf("read refusal record %s: %w", entry.Name(), err)
+		}
+		var record refusalRecord
+		if err := json.Unmarshal(data, &record); err != nil {
+			return nil, fmt.Errorf("read refusal record %s: %w", entry.Name(), err)
+		}
+		if record.SchemaVersion != 1 || record.Causes == nil {
+			return nil, fmt.Errorf("read refusal record %s: unexpected schema", entry.Name())
+		}
+		for _, cause := range record.Causes {
+			for _, stored := range cause.Incidents {
+				incident := Incident{
+					Class: cause.Class, Cause: stored.Cause, Component: stored.Component,
+					Generation: stored.Generation, DeadlineEnd: stored.DeadlineEnd, Source: SourceRefusalRecord,
+				}
+				if cause.Class != "infrastructure" || incident.Cause == "" || incident.Component == "" ||
+					incident.Generation == "" || incident.DeadlineEnd <= 0 ||
+					(stored.Identity != "" && stored.Identity != Identity(incident)) {
+					return nil, fmt.Errorf("read refusal record %s: invalid stop incident", entry.Name())
+				}
+				incidents = append(incidents, incident)
+			}
+		}
+	}
+	return incidents, nil
+}
+
+func validIdentity(identity string) bool {
+	if len(identity) != 16 {
+		return false
+	}
+	_, err := hex.DecodeString(identity)
+	return err == nil
+}
diff --git a/metasystem/internal/stopincident/stopincident_test.go b/metasystem/internal/stopincident/stopincident_test.go
