+		writeStopIncidentHookLog(t, root, incident)
+		if got := DrainStopIncidents(root, cfg.now()); got.Queued != 1 {
+			t.Fatalf("queue incident: %+v", got)
+		}
+		sender := func(_, message string) error {
+			if !strings.Contains(message, incident.Cause) {
+				t.Fatalf("channel saw message=%q", message)
+			}
+			return os.ErrPermission
+		}
+		if delivered, err := deliverPending(root, sender); err == nil || delivered != 0 {
+			t.Fatalf("failed channel delivered=%d err=%v", delivered, err)
+		}
+		if pending, err := PendingNotifications(root); err != nil || len(pending) != 1 || pending[0].DeliveredAt != "" {
+			t.Fatalf("channel failure pending=%+v err=%v", pending, err)
+		}
+		ledger, _ := os.ReadFile(stopIncidentLedgerPath(root, now))
+		if strings.Contains(string(ledger), "delivered ") {
+			t.Fatalf("failed channel wrote a delivered ledger line: %q", ledger)
+		}
+	})
