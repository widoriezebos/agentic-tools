+func deliverPendingStopIncident(repoRoot string, notification PendingNotification, sender func(string, string) error) error {
+	if notification.DeliveredAt == "" {
+		if err := sender(repoRoot, notification.Message); err != nil {
+			return err
+		}
+		notification.DeliveredAt = time.Now().UTC().Format(time.RFC3339Nano)
+		if err := QueueNotification(repoRoot, notification); err != nil {
+			return fmt.Errorf("stamp delivered stop incident: %w", err)
+		}
+	}
+	if err := appendStopIncidentDelivery(repoRoot, notification); err != nil {
+		return err
+	}
+	if err := MarkDelivered(repoRoot, notification.Nonce); err != nil {
+		return err
+	}
+	identity := strings.TrimPrefix(notification.Nonce, "stop-incident-")
+	deliveredAt, err := time.Parse(time.RFC3339Nano, notification.DeliveredAt)
+	if err == nil {
+		_ = stopincident.AppendAck(stopIncidentHookLogPath(repoRoot), identity, deliveredAt)
+	}
+	return nil
+}
