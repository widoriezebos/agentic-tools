index 000000000..a9e775e88
--- /dev/null
+++ b/metasystem/internal/stopincident/stopincident_test.go
@@ -0,0 +1,52 @@
+package stopincident
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestHookLogLinesRoundTrip(t *testing.T) {
+	t.Parallel()
+
+	root := t.TempDir()
+	path := filepath.Join(root, "hooks.log")
+	body := "noise the parser must ignore\n" +
+		"stop-condition infrastructure hook-unreadable stop-worker 7 1789812060 degraded-allow\n" +
+		"stop-condition infrastructure hook-unreadable stop-worker 7 1789812060 retrying\n" +
+		"stop-condition infrastructure hook-unreadable stop-worker 8 1789812060 degraded-allow\n" +
+		"stop-condition infrastructure hook-unreadable stop-worker 7 1789812120 degraded-allow\n" +
+		"stop-condition seat-actionable owned-work verdict-state 7 1789812060 refused\n" +
+		"stop-condition infrastructure too-short\n"
+	if err := os.WriteFile(path, []byte(body), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := AppendAck(path, "0123456789abcdef", time.Unix(1789812070, 0)); err != nil {
+		t.Fatal(err)
+	}
+
+	incidents, acked, err := ReadHookLog(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(incidents) != 4 {
+		t.Fatalf("ReadHookLog incidents=%d, want 4: %+v", len(incidents), incidents)
+	}
+	if !acked["0123456789abcdef"] || len(acked) != 1 {
+		t.Fatalf("ReadHookLog acknowledgments=%v, want the appended identity", acked)
+	}
+	want := Incident{Class: "infrastructure", Cause: "hook-unreadable", Component: "stop-worker", Generation: "7", DeadlineEnd: 1789812060, Outcome: "degraded-allow", Source: SourceHookLog}
+	if incidents[0] != want {
+		t.Fatalf("first incident=%+v, want %+v", incidents[0], want)
+	}
+	if Identity(incidents[0]) != Identity(incidents[1]) {
+		t.Fatalf("outcome changed identity: %s != %s", Identity(incidents[0]), Identity(incidents[1]))
+	}
+	if Identity(incidents[0]) == Identity(incidents[2]) {
+		t.Fatal("another generation reused the incident identity")
+	}
+	if Identity(incidents[0]) == Identity(incidents[3]) {
+		t.Fatal("another deadline end reused the incident identity")
+	}
+}
diff --git a/metasystem/internal/steward/stopincident.go b/metasystem/internal/steward/stopincident.go
new file mode 100644
index 000000000..ccf40436f
--- /dev/null
+++ b/metasystem/internal/steward/stopincident.go
@@ -0,0 +1,263 @@
+package steward
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/widoriezebos/agentic-tools/metasystem/internal/stopincident"
+)
+
+const maxStopIncidentsPerTick = 20
+
+// StopIncidentDrain reports the bounded work done while moving infrastructure
+// stop incidents toward the operator.
+type StopIncidentDrain struct {
+	Queued      int    `json:"queued"`
+	Pending     int    `json:"pending"`
+	Unconfirmed bool   `json:"unconfirmed"`
+	Detail      string `json:"detail,omitempty"`
+}
+
+type stopIncidentLedger struct {
+	exists    bool
+	start     int64
+	delivered map[string]bool
+}
+
+func stopIncidentLedgerPath(repoRoot string, day time.Time) string {
+	return filepath.Join(repoRoot, "artifacts", "agents", "steward", "stop-incidents", day.UTC().Format("2006-01-02")+".log")
+}
+
+func stopIncidentHookLogPath(repoRoot string) string {
+	return filepath.Join(repoRoot, "artifacts", "agents", "supervision", "hooks.log")
+}
+
+func stopIncidentRefusalDir(repoRoot string) string {
+	return filepath.Join(repoRoot, "artifacts", "agents", "supervision", "stop-refusals")
+}
+
+func readStopIncidentLedger(path string) (stopIncidentLedger, error) {
+	ledger := stopIncidentLedger{delivered: map[string]bool{}}
+	file, err := os.Open(path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return ledger, nil
+		}
+		return ledger, err
+	}
+	defer file.Close()
+	ledger.exists = true
+	scanner := bufio.NewScanner(file)
+	for scanner.Scan() {
+		fields := strings.Fields(scanner.Text())
+		switch {
+		case len(fields) == 2 && fields[0] == "drain-start":
+			stamp, parseErr := strconv.ParseInt(fields[1], 10, 64)
+			if parseErr != nil || stamp <= 0 {
+				return ledger, fmt.Errorf("invalid drain-start line")
+			}
+			if ledger.start == 0 || stamp < ledger.start {
+				ledger.start = stamp
+			}
+		case len(fields) == 4 && fields[0] == "delivered":
+			if len(fields[1]) != 16 {
+				return ledger, fmt.Errorf("invalid delivered identity")
+			}
+			if _, parseErr := strconv.ParseInt(fields[2], 10, 64); parseErr != nil {
+				return ledger, fmt.Errorf("invalid delivered timestamp")
+			}
+			ledger.delivered[fields[1]] = true
+		default:
+			return ledger, fmt.Errorf("invalid stop-incident ledger line")
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		return ledger, err
+	}
+	if ledger.start == 0 {
+		return ledger, fmt.Errorf("stop-incident ledger has no drain-start")
+	}
+	return ledger, nil
+}
+
+func appendStopIncidentLedgerLine(path, line string) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return err
+	}
+	file, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o600)
+	if err != nil {
+		return err
+	}
+	if _, err := file.WriteString(line); err != nil {
+		_ = file.Close()
+		return err
+	}
+	return file.Close()
+}
+
+func ensureStopIncidentDayStarted(path string, now time.Time) error {
+	ledger, err := readStopIncidentLedger(path)
+	if err != nil {
+		return err
+	}
+	if ledger.exists {
+		return nil
+	}
+	return appendStopIncidentLedgerLine(path, fmt.Sprintf("drain-start %d\n", now.UTC().Unix()))
+}
+
+// DrainStopIncidents merges the current hook and refusal sources against the
+// two-day append-only ledger. A missing ledger establishes a history boundary
+// before any incident can be queued.
+func DrainStopIncidents(repoRoot string, now time.Time) StopIncidentDrain {
+	now = now.UTC()
+	todayPath := stopIncidentLedgerPath(repoRoot, now)
+	yesterdayPath := stopIncidentLedgerPath(repoRoot, now.AddDate(0, 0, -1))
+	today, todayErr := readStopIncidentLedger(todayPath)
+	yesterday, yesterdayErr := readStopIncidentLedger(yesterdayPath)
+	if todayErr != nil || yesterdayErr != nil {
+		return StopIncidentDrain{Unconfirmed: true, Detail: "stop-incident ledger unreadable: " + joinStopIncidentErrors(todayErr, yesterdayErr)}
+	}
+	if !today.exists {
+		if err := ensureStopIncidentDayStarted(todayPath, now); err != nil {
+			return StopIncidentDrain{Unconfirmed: true, Detail: "stop-incident ledger could not record drain-start: " + err.Error()}
+		}
+		today, todayErr = readStopIncidentLedger(todayPath)
+		if todayErr != nil {
+			return StopIncidentDrain{Unconfirmed: true, Detail: "stop-incident ledger unreadable after drain-start: " + todayErr.Error()}
+		}
+		if !yesterday.exists {
+			return StopIncidentDrain{}
+		}
+	}
+
+	historyStart := today.start
+	if yesterday.exists && (historyStart == 0 || yesterday.start < historyStart) {
+		historyStart = yesterday.start
+	}
+	delivered := map[string]bool{}
+	for identity := range yesterday.delivered {
+		delivered[identity] = true
+	}
+	for identity := range today.delivered {
+		delivered[identity] = true
+	}
+
+	hookIncidents, acked, hookErr := stopincident.ReadHookLog(stopIncidentHookLogPath(repoRoot))
+	refusalIncidents, refusalErr := stopincident.ReadRefusalRecords(stopIncidentRefusalDir(repoRoot))
+	if hookErr != nil && refusalErr != nil {
+		return StopIncidentDrain{Unconfirmed: true, Detail: "stop-incident sources unreadable: " + joinStopIncidentErrors(hookErr, refusalErr)}
+	}
+	merged := map[string]stopincident.Incident{}
+	for _, incident := range refusalIncidents {
+		if incident.DeadlineEnd >= historyStart {
+			merged[stopincident.Identity(incident)] = incident
+		}
+	}
+	for _, incident := range hookIncidents {
+		if incident.DeadlineEnd >= historyStart {
+			merged[stopincident.Identity(incident)] = incident
+		}
+	}
+
+	pendingNotifications, err := PendingNotifications(repoRoot)
+	if err != nil {
+		return StopIncidentDrain{Unconfirmed: true, Detail: "stop-incident queue unreadable: " + err.Error()}
+	}
+	pending := map[string]bool{}
+	for _, notification := range pendingNotifications {
+		if strings.HasPrefix(notification.Nonce, "stop-incident-") {
+			pending[strings.TrimPrefix(notification.Nonce, "stop-incident-")] = true
+		}
+	}
+
+	identities := make([]string, 0, len(merged))
+	for identity := range merged {
+		identities = append(identities, identity)
+	}
+	sort.Strings(identities)
+	result := StopIncidentDrain{Pending: len(pending)}
+	for _, identity := range identities {
+		if result.Queued >= maxStopIncidentsPerTick || delivered[identity] || pending[identity] {
+			continue
+		}
+		incident := merged[identity]
+		notification := PendingNotification{
+			Nonce:              "stop-incident-" + identity,
+			Message:            fmt.Sprintf("steward: Stop infrastructure incident — cause %s; component %s; deadline %d", incident.Cause, incident.Component, incident.DeadlineEnd),
+			StopIncidentSource: incident.Source,
+			StopIncidentDay:    now.Format("2006-01-02"),
+		}
+		if err := QueueNotification(repoRoot, notification); err != nil {
+			result.Unconfirmed = true
+			result.Detail = "stop-incident queue write failed: " + err.Error()
+			break
+		}
+		pending[identity] = true
+		result.Queued++
+		result.Pending++
+	}
+
+	if hookErr == nil {
+		repaired := 0
+		deliveredIdentities := make([]string, 0, len(delivered))
+		for identity := range delivered {
+			deliveredIdentities = append(deliveredIdentities, identity)
+		}
+		sort.Strings(deliveredIdentities)
+		for _, identity := range deliveredIdentities {
+			if repaired >= maxStopIncidentsPerTick || acked[identity] {
+				continue
+			}
+			if err := stopincident.AppendAck(stopIncidentHookLogPath(repoRoot), identity, now); err != nil {
+				break
+			}
+			repaired++
+		}
+	}
+	return result
+}
+
+func joinStopIncidentErrors(errors ...error) string {
+	parts := make([]string, 0, len(errors))
+	for _, err := range errors {
+		if err != nil {
+			parts = append(parts, err.Error())
+		}
+	}
+	return strings.Join(parts, "; ")
+}
+
+func appendStopIncidentDelivery(repoRoot string, notification PendingNotification) error {
+	identity := strings.TrimPrefix(notification.Nonce, "stop-incident-")
+	if identity == notification.Nonce || notification.StopIncidentDay == "" || notification.StopIncidentSource == "" {
+		return fmt.Errorf("pending stop incident has incomplete delivery coordinates")
+	}
+	day, err := time.Parse("2006-01-02", notification.StopIncidentDay)
+	if err != nil {
+		return fmt.Errorf("pending stop incident has invalid ledger day: %w", err)
+	}
+	path := stopIncidentLedgerPath(repoRoot, day)
+	ledger, err := readStopIncidentLedger(path)
+	if err != nil {
+		return fmt.Errorf("read stop-incident delivery ledger: %w", err)
+	}
+	if !ledger.exists {
+		return fmt.Errorf("stop-incident delivery ledger is missing")
+	}
+	if ledger.delivered[identity] {
+		return nil
+	}
+	deliveredAt, err := time.Parse(time.RFC3339Nano, notification.DeliveredAt)
+	if err != nil {
+		return fmt.Errorf("pending stop incident has invalid delivery stamp: %w", err)
+	}
+	line := fmt.Sprintf("delivered %s %d %s\n", identity, deliveredAt.UTC().Unix(), notification.StopIncidentSource)
+	return appendStopIncidentLedgerLine(path, line)
+}
