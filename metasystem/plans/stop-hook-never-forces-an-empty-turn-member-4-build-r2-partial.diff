+package goal
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestBoardJoinReadsOlderRecords(t *testing.T) {
+	t.Parallel()
+	now := time.Date(2026, 9, 19, 10, 0, 0, 0, time.UTC)
+	held := budgetedQueuedGoal("held", "2026-08-23T00:00:00Z")
+	held.State = StateClaimed
+	held.Revision = 2
+	held.Claimed = &ClaimRecord{Machine: "bed-m1", Lineage: "lineage-a", At: "2026-08-23T01:00:00Z", Revision: 2}
+	root := servingBed(t, "bed-m1", map[string]*GoalFile{"held": held})
+	jobs := filepath.Join(root, "artifacts", "agents", "jobs")
+	writeIdleJSON(t, filepath.Join(jobs, "missing.json"), map[string]any{
+		"jobId": "missing", "goalId": "held", "machineId": "bed-m1", "status": "running",
+		"pid": 41, "pidStartedAt": 100,
+	})
+	writeIdleJSON(t, filepath.Join(jobs, "fractional.json"), map[string]any{
+		"jobId": "fractional", "goalId": "held", "machineId": "bed-m1", "goalRevision": 2.5,
+		"claimEpoch": 7, "status": "running", "pid": 42, "pidStartedAt": 101,
+	})
+	owner := BoardOwner{Machine: "bed-m1", Lineage: "lineage-a", ClaimEpoch: 7}
+	work, err := readClaimableBudgetedWork(root, now, owner, idleFixtureProber{
+		41: {Pid: 41, StartedAt: time.Unix(100, 0)},
+		42: {Pid: 42, StartedAt: time.Unix(101, 0)},
+	}, projectionDependencies{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if work.Board == nil || len(work.Board.Activity) != 2 {
+		t.Fatalf("older live records were not listed on the board: %+v", work.Board)
+	}
+	for _, row := range work.Board.Activity {
+		if row.Joined {
+			t.Fatalf("an incomplete older record joined: %+v", row)
+		}
+		if !strings.Contains(row.Reason, "missing") {
+			t.Fatalf("the missing coordinate was not named: %+v", row)
+		}
+	}
+}
