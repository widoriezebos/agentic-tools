+func TestTurnVerdictSeatWiringRechecksTheBoard(t *testing.T) {
+	t.Parallel()
+	root := t.TempDir()
+	for _, args := range [][]string{
+		{"init", "-q", "-b", "main"},
+		{"config", "user.name", "turn-verdict-fixture"},
+		{"config", "user.email", "turn-verdict-fixture@example.invalid"},
+		{"config", "metasystem.goal.machine", "fixture-machine"},
+	} {
+		if output, err := exec.Command("git", append([]string{"-C", root}, args...)...).CombinedOutput(); err != nil {
+			t.Fatalf("git %v: %v %s", args, err, output)
+		}
+	}
+	if err := os.WriteFile(filepath.Join(root, "accepted.txt"), []byte("accepted\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	for _, args := range [][]string{{"add", "accepted.txt"}, {"commit", "-q", "-m", "accepted fixture"}, {"update-ref", goal.AcceptedRef, "HEAD"}} {
+		if output, err := exec.Command("git", append([]string{"-C", root}, args...)...).CombinedOutput(); err != nil {
+			t.Fatalf("git %v: %v %s", args, err, output)
+		}
+	}
+	exact, state, err := (identity.KernelProber{}).Probe(int64(os.Getpid()))
+	if err != nil || state != identity.Alive {
+		t.Fatalf("current process identity=%+v state=%s err=%v", exact, state, err)
+	}
+	announcement, err := lease.AnnounceWithPair(root, "turn-verdict-fixture", exact.Pid, exact.StartedAt.Unix(), exact.StartTicks, exact.BootID, "turn-verdict-fixture", "fake", "fixture-lineage")
+	if err != nil {
+		t.Fatal(err)
+	}
+	mainID := announcedMainID(t, announcement)
+	store := &goal.Store{Root: root}
+	options := goal.TurnVerdictOptions{}
+	wireTurnVerdictSeat(root, mainID, time.Date(2026, 9, 19, 12, 0, 0, 0, time.UTC), store, &options)
+	if options.RecheckBoard == nil {
+		t.Fatal("turn verdict seat wiring did not set RecheckBoard")
+	}
+	wantTip, wantTipErr := goal.AcceptedTip(root)
+	_, wantEpoch, wantEpochErr := resolveSeatIdleActor(root, mainID)()
+	gotTip, gotEpoch, gotErr := options.RecheckBoard()
+	if wantTipErr != nil || wantEpochErr != nil {
+		t.Fatalf("fixture board state: accepted tip error=%v seat error=%v", wantTipErr, wantEpochErr)
+	}
+	if gotErr != nil || gotTip != wantTip || gotEpoch != wantEpoch {
+		t.Fatalf("RecheckBoard() = (%q, %d, %v), want (%q, %d, nil)", gotTip, gotEpoch, gotErr, wantTip, wantEpoch)
+	}
+}
