diff --git a/metasystem/internal/goal/stopboard.go b/metasystem/internal/goal/stopboard.go
new file mode 100644
index 000000000..5048b4e04
--- /dev/null
+++ b/metasystem/internal/goal/stopboard.go
@@ -0,0 +1,169 @@
+package goal
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+	"time"
+)
+
+// BoardOwner identifies the checkout claim whose stop is being judged.
+type BoardOwner struct {
+	Machine    string `json:"machine"`
+	Lineage    string `json:"lineage"`
+	ClaimEpoch int64  `json:"claimEpoch"`
+}
+
+// BoardGoal is the goal information needed by a stop decision.
+type BoardGoal struct {
+	Id       string `json:"id"`
+	Revision uint64 `json:"revision"`
+	Intent   string `json:"intent"`
+	NextStep string `json:"nextStep"`
+}
+
+// BoardActivity is one live job or governed run and its join result.
+type BoardActivity struct {
+	Ref        string  `json:"ref"`
+	GoalId     string  `json:"goalId,omitempty"`
+	Revision   *uint64 `json:"revision,omitempty"`
+	ClaimEpoch *int64  `json:"claimEpoch,omitempty"`
+	Machine    string  `json:"machine,omitempty"`
+	Lineage    string  `json:"lineage,omitempty"`
+	Joined     bool    `json:"joined"`
+	Reason     string  `json:"reason"`
+}
+
+// StopBoard is the single accepted-world snapshot used by one stop decision.
+type StopBoard struct {
+	Owner         BoardOwner      `json:"owner"`
+	Tip           string          `json:"tip"`
+	FetchedAt     time.Time       `json:"fetchedAt"`
+	ProjectedAt   time.Time       `json:"projectedAt"`
+	Held          []BoardGoal     `json:"held"`
+	HeldElsewhere []BoardGoal     `json:"heldElsewhere"`
+	Ready         []BoardGoal     `json:"ready"`
+	Activity      []BoardActivity `json:"activity"`
+	tree          *TreeGoals
+}
+
+// HasJoinedWork reports whether a live job or governed run belongs to the
+// exact owner and goal revision represented by this board.
+func (b *StopBoard) HasJoinedWork() bool {
+	if b == nil {
+		return false
+	}
+	for _, activity := range b.Activity {
+		if activity.Joined {
+			return true
+		}
+	}
+	return false
+}
+
+// ExcludeJob removes one job from this decision without changing the stored
+// activity record used by other readers.
+func (b *StopBoard) ExcludeJob(id string) {
+	if b == nil {
+		return
+	}
+	ref := "job:" + id
+	for index := range b.Activity {
+		if b.Activity[index].Ref == ref {
+			b.Activity[index].Joined = false
+			b.Activity[index].Reason = "excluded from this stop decision"
+		}
+	}
+}
+
+func newStopBoard(projection Projection, frontier NextVerdict, owner BoardOwner, activity []BoardActivity, now time.Time) *StopBoard {
+	board := &StopBoard{
+		Owner: owner, Tip: projection.Tip, FetchedAt: now, ProjectedAt: now,
+		Activity: append([]BoardActivity(nil), activity...), tree: projection.Tree,
+	}
+	if projection.Tree == nil {
+		return board
+	}
+	for _, id := range append(append([]string(nil), frontier.Claimed...), frontier.Landing...) {
+		file := projection.Tree.Live[id]
+		if file == nil || file.Claimed == nil {
+			continue
+		}
+		goal := boardGoal(file)
+		if owner.Lineage != "" && file.Claimed.Machine == owner.Machine && file.Claimed.Lineage == owner.Lineage {
+			board.Held = append(board.Held, goal)
+		} else {
+			board.HeldElsewhere = append(board.HeldElsewhere, goal)
+		}
+	}
+	for _, id := range frontier.Ready {
+		if file := projection.Tree.Live[id]; file != nil {
+			board.Ready = append(board.Ready, boardGoal(file))
+		}
+	}
+	board.joinActivity()
+	return board
+}
+
+func boardGoal(file *GoalFile) BoardGoal {
+	return BoardGoal{Id: file.Id, Revision: file.Revision, Intent: file.Intent, NextStep: file.NextStep}
+}
+
+func (b *StopBoard) joinActivity() {
+	held := make(map[string]BoardGoal, len(b.Held))
+	for _, goal := range b.Held {
+		held[goal.Id] = goal
+	}
+	for index := range b.Activity {
+		row := &b.Activity[index]
+		goal, present := held[row.GoalId]
+		missing := boardActivityMissing(*row)
+		if missing != "" {
+			row.Reason = "missing " + missing
+			continue
+		}
+		if !present {
+			row.Reason = "goal is not held by this owner"
+			continue
+		}
+		if strings.HasPrefix(row.Ref, "job:") && row.Machine != b.Owner.Machine {
+			row.Reason = "machine does not match the owner"
+			continue
+		}
+		if strings.HasPrefix(row.Ref, "run:") && row.Lineage != b.Owner.Lineage {
+			row.Reason = "lineage does not match the owner"
+			continue
+		}
+		if *row.Revision != goal.Revision {
+			row.Reason = fmt.Sprintf("revision %d does not match held revision %d", *row.Revision, goal.Revision)
+			continue
+		}
+		if *row.ClaimEpoch != b.Owner.ClaimEpoch {
+			row.Reason = fmt.Sprintf("claim epoch %d does not match owner epoch %d", *row.ClaimEpoch, b.Owner.ClaimEpoch)
+			continue
+		}
+		row.Joined = true
+		row.Reason = "joined to the owner and held revision"
+	}
+	sort.Slice(b.Activity, func(i, j int) bool { return b.Activity[i].Ref < b.Activity[j].Ref })
+}
+
+func boardActivityMissing(row BoardActivity) string {
+	var missing []string
+	if row.GoalId == "" {
+		missing = append(missing, "goal id")
+	}
+	if strings.HasPrefix(row.Ref, "job:") && row.Machine == "" {
+		missing = append(missing, "machine id")
+	}
+	if strings.HasPrefix(row.Ref, "run:") && row.Lineage == "" {
+		missing = append(missing, "owner lineage")
+	}
+	if row.Revision == nil {
+		missing = append(missing, "goal revision")
+	}
+	if row.ClaimEpoch == nil {
+		missing = append(missing, "claim epoch")
+	}
+	return strings.Join(missing, ", ")
+}
