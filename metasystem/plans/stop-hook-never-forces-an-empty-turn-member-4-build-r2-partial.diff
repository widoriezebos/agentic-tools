+	store.ResolveIdleSeat = resolveSeatIdleActor(stateRoot, mainID)
+	options.RecheckBoard = func() (string, int64, error) {
+		tip, err := goal.AcceptedTip(stateRoot)
+		if err != nil {
+			return "", 0, err
+		}
+		_, epoch, err := resolveSeatIdleActor(stateRoot, mainID)()
+		return tip, epoch, err
+	}
