+// AcceptedTip reads the accepted commit without fetching or changing refs.
+func AcceptedTip(root string) (string, error) {
+	tip, present, err := acceptedTipForGates(root)
+	if err != nil {
+		return "", err
+	}
+	if !present {
+		return "", nil
+	}
+	return tip, nil
+}
