+func installFakeStopReplayBed(t *testing.T, engine string) string {
+	t.Helper()
+	root := t.TempDir()
+	sourceRoot, err := filepath.Abs(filepath.Join("..", ".."))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, relative := range []string{
+		"scripts/receipt.sh",
+		"scripts/agents/supervision-hook.sh",
+		"scripts/agents/evidence-gc.sh",
+		"scripts/agents/arm-supervision.sh",
+		"scripts/agents/dispatch.sh",
+		"scripts/agents/adapters/fake.sh",
+		"scripts/agents/adapters/runtime-common.sh",
+		"scripts/enforcement/claude-code-hooks.json",
+		"scripts/watch-background-jobs.sh",
+		"scripts/metasystem-config.sh",
+	} {
+		copyFakeStopReplayFile(t, filepath.Join(sourceRoot, relative), filepath.Join(root, relative), 0o755)
+	}
+	canonical := filepath.Join(root, "bin", "metasystem")
+	copyFakeStopReplayFile(t, engine, canonical, 0o755)
+	if output, err := exec.Command("git", "-C", root, "init", "-q", "-b", "main").CombinedOutput(); err != nil {
+		t.Fatalf("initialize stop replay bed: %v %s", err, output)
+	}
+	if err := os.WriteFile(filepath.Join(root, "metasystem.conf"), []byte("metasystem.runtimes=claude\nrole.default.model.claude=fixture\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	canonicalRoot, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(canonical)
+	if err != nil {
+		t.Fatal(err)
+	}
+	digest := sha256.Sum256(data)
+	if err := os.MkdirAll(filepath.Dir(steward.RepoIdentityPath(canonicalRoot)), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := steward.MintIdentity(steward.RepoIdentityPath(canonicalRoot), steward.InstallIdentity{
+		RepoIdentity: canonicalRoot, Generation: 1, InstallPath: canonical,
+		InstallDigest: fmt.Sprintf("sha256:%x", digest), MintedAt: time.Now().UTC().Format(time.RFC3339Nano),
+		Enrollment: steward.EnrollmentFixture,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	return root
+}
+
+func copyFakeStopReplayFile(t *testing.T, source, target string, mode os.FileMode) {
+	t.Helper()
+	data, err := os.ReadFile(source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(filepath.Dir(target), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(target, data, mode); err != nil {
+		t.Fatal(err)
+	}
+}
