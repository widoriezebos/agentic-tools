+func runFakeStopReplay(t *testing.T, fixture *testutil.ProcessFixture, root, cause, fault, label string, withoutOwner bool) string {
+	t.Helper()
+	action := filepath.Join(root, "scripts", "agents", "adapters", "fake.sh")
+	script := `exec "$1" stop-replay --root "$2" --session "$3" --cause "$4" --fault "$5"`
+	if withoutOwner {
+		script = `exec env -u METASYSTEM_FIXTURE_OWNER "$1" stop-replay --root "$2" --session "$3" --cause "$4" --fault "$5"`
+	}
+	command := fixture.Shell(script, action, root, label, cause, fault)
+	var stdout, stderr strings.Builder
+	command.Stdout, command.Stderr = &stdout, &stderr
+	if err := command.Start(); err != nil {
+		t.Fatalf("start %s: %v", label, err)
+	}
+	fixture.Record(command.Process.Pid)
+	if err := command.Wait(); err != nil {
+		t.Fatalf("%s: %v\nstdout=%s\nstderr=%s", label, err, stdout.String(), stderr.String())
+	}
+	if stderr.Len() != 0 {
+		t.Logf("%s hook diagnostics: %s", label, stderr.String())
+	}
+	return stdout.String()
+}
+
+func allowedStopMessage(t *testing.T, response string) string {
+	t.Helper()
+	decoder := json.NewDecoder(strings.NewReader(response))
+	var object map[string]any
+	if err := decoder.Decode(&object); err != nil {
+		t.Fatalf("response is not one JSON object: %v: %q", err, response)
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		t.Fatalf("response contains trailing data: %v: %q", err, response)
+	}
+	if decision, present := object["decision"]; present {
+		t.Fatalf("response did not allow Stop: decision=%v response=%q", decision, response)
+	}
+	message, ok := object["systemMessage"].(string)
+	if !ok || message == "" {
+		t.Fatalf("response has no systemMessage: %q", response)
+	}
+	return message
+}
+
+func readOptionalFixtureFile(t *testing.T, path string) string {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if os.IsNotExist(err) {
+		return ""
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(data)
+}
+
+func assertFakeStopReplayCalls(t *testing.T, calls string) {
+	t.Helper()
+	allowed := map[string]bool{
+		"adapter stop-output": true, "health --hook-preview": true, "json get": true,
+		"json object": true, "json strip": true, "lease classify": true,
+		"lease hook-delegate": true, "lease require-holder": true, "path state-root": true, "proc find-ancestor": true,
+		"receipt check": true, "report stop-block": true, "report stop-input": true,
+		"report stop-present": true, "report turn-verdict": true, "runtime list": true,
+		"steward digest-pending": true, "steward hook-attempt": true, "steward hook-complete": true,
+		"steward hook-expire": true, "supervise watchdog-report": true, "up --metasystem-root": true,
+		"util sha256": true, "util slug": true, "util token-hex": true,
+	}
+	for _, call := range strings.Split(strings.TrimSpace(calls), "\n") {
+		if call != "" && !allowed[call] {
+			t.Fatalf("unexpected fake stop replay engine call %q in replay-calls.log:\n%s", call, calls)
+		}
+	}
+}
+
+func resolveFakeStopReplayReport(t *testing.T, root, session, response string) string {
+	t.Helper()
+	canonicalRoot, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resolved, err := stopreport.ResolveResponse(canonicalRoot, []byte(response), "claude", session)
+	if err != nil {
+		t.Fatalf("resolve %s Stop report: %v", session, err)
+	}
+	return string(resolved.Report)
+}
+
+func waitForFakeStopReplayChildren(t *testing.T, fixture *testutil.ProcessFixture) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if err := fixture.WaitForNoUnrecordedChildren(ctx); err != nil {
+		t.Fatal(err)
+	}
+}
