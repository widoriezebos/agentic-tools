+func TestFakeStopReplay(t *testing.T) {
+	t.Parallel()
+
+	engine := filepath.Join(t.TempDir(), "metasystem")
+	build := exec.Command("go", "build", "-o", engine, ".")
+	if output, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("build stop replay engine: %v\n%s", err, output)
+	}
+
+	t.Run("FakeReplayUnreadableHookState", func(t *testing.T) {
+		t.Parallel()
+		fixture := testutil.Fixture(t)
+		cases := []struct {
+			fault             string
+			wantLogFailure    bool
+			wantRecordFailure bool
+			wantUnconfirmed   bool
+			wantReplayCall    bool
+		}{
+			{fault: "none", wantReplayCall: true},
+			{fault: "hook-log", wantLogFailure: true, wantReplayCall: true},
+			{fault: "incident-state", wantRecordFailure: true, wantReplayCall: true},
+			{fault: "both", wantLogFailure: true, wantRecordFailure: true, wantUnconfirmed: true, wantReplayCall: true},
+			{fault: "engine"},
+			{fault: "engine", wantLogFailure: true},
+		}
+		for index, testCase := range cases {
+			root := installFakeStopReplayBed(t, engine)
+			if index == 5 {
+				if err := os.MkdirAll(filepath.Join(root, "artifacts", "agents", "supervision", "hooks.log"), 0o755); err != nil {
+					t.Fatal(err)
+				}
+			}
+			response := runFakeStopReplay(t, fixture, root, "arming", testCase.fault, fmt.Sprintf("arming-%d", index+1), false)
+			message := allowedStopMessage(t, response)
+			if testCase.fault == "engine" {
+				want := "Task unknown; Stop allowed; needs supervision repair; engine missing. Rebuild bin/metasystem. Status un" + "available."
+				if message != want {
+					t.Fatalf("run %d missing-engine message = %q; want %q", index+1, message, want)
+				}
+			} else {
+				report := resolveFakeStopReplayReport(t, root, fmt.Sprintf("arming-%d", index+1), response)
+				if strings.Contains(report, "could not be appended to the hook log") != testCase.wantLogFailure {
+					calls := readOptionalFixtureFile(t, filepath.Join(root, "artifacts", "agents", "fake-stop-replay", "replay-calls.log"))
+					t.Fatalf("run %d hook-log failure presence = %t in %q; calls=%q", index+1, !testCase.wantLogFailure, report, calls)
+				}
+				if strings.Contains(report, "stop-refusal record failure") != testCase.wantRecordFailure {
+					t.Fatalf("run %d record failure presence = %t in %q", index+1, !testCase.wantRecordFailure, report)
+				}
+				if strings.Contains(report, fakeStopReplayDeliveryUnconfirmed) != testCase.wantUnconfirmed {
+					t.Fatalf("run %d delivery-unconfirmed presence = %t in %q", index+1, !testCase.wantUnconfirmed, report)
+				}
+			}
+			if testCase.fault == "engine" && strings.Contains(message, fakeStopReplayDeliveryUnconfirmed) != testCase.wantUnconfirmed {
+				t.Fatalf("run %d delivery-unconfirmed presence = %t in %q", index+1, !testCase.wantUnconfirmed, message)
+			}
+			calls := readOptionalFixtureFile(t, filepath.Join(root, "artifacts", "agents", "fake-stop-replay", "replay-calls.log"))
+			if strings.Contains(calls, "report stop-block") != testCase.wantReplayCall {
+				t.Fatalf("run %d replay calls = %q", index+1, calls)
+			}
+			assertFakeStopReplayCalls(t, calls)
+		}
+		waitForFakeStopReplayChildren(t, fixture)
+	})
+
+	t.Run("FakeReplayDeadlineUnreadable", func(t *testing.T) {
+		t.Parallel()
+		fixture := testutil.Fixture(t)
+		for index, testCase := range []struct {
+			fault           string
+			wantRecord      bool
+			wantCondition   bool
+			wantUnconfirmed bool
+		}{
+			{fault: "none"},
+			{fault: "hook-log", wantCondition: true},
+			{fault: "incident-state", wantRecord: true},
+			{fault: "both", wantRecord: true, wantCondition: true, wantUnconfirmed: true},
+		} {
+			root := installFakeStopReplayBed(t, engine)
+			response := runFakeStopReplay(t, fixture, root, "deadline", testCase.fault, fmt.Sprintf("deadline-%d", index+1), false)
+			message := allowedStopMessage(t, response)
+			if strings.Contains(message, "record update failed") != testCase.wantRecord ||
+				strings.Contains(message, "condition log failed") != testCase.wantCondition ||
+				strings.Contains(message, "steward delivery unconfirmed") != testCase.wantUnconfirmed {
+				t.Fatalf("deadline run %d qualifiers do not match fault %s: %q", index+1, testCase.fault, message)
+			}
+			if testCase.fault != "hook-log" && testCase.fault != "both" {
+				log := readOptionalFixtureFile(t, filepath.Join(root, "artifacts", "agents", "supervision", "hooks.log"))
+				if !strings.Contains(log, "stop-condition infrastructure stop-deadline-expired stop-deadline - 1000000004 degraded-allow") {
+					t.Fatalf("deadline run %d did not use the fixture epoch: %q", index+1, log)
+				}
+			}
+			assertFakeStopReplayCalls(t, readOptionalFixtureFile(t, filepath.Join(root, "artifacts", "agents", "fake-stop-replay", "replay-calls.log")))
+		}
+
+		root := installFakeStopReplayBed(t, engine)
+		response := runFakeStopReplay(t, fixture, root, "deadline", "none", "deadline-seam-off", true)
+		_ = allowedStopMessage(t, response)
+		log := readOptionalFixtureFile(t, filepath.Join(root, "artifacts", "agents", "supervision", "hooks.log"))
+		if strings.Contains(log, "stop-condition infrastructure stop-deadline-expired stop-deadline - 1000000004 degraded-allow") {
+			t.Fatalf("deadline seam was honored without the fixture owner tag: %q", log)
+		}
+		waitForFakeStopReplayChildren(t, fixture)
+	})
+}
