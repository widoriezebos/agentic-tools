+stop_replay() {
+  local bed= session= cause= fault= action_dir seam_dir release_file wrapper engine
+  local hook_config command_line stop_command payload response
+  while (($#)); do
+    case "$1" in
+      --root) [[ $# -ge 2 ]] || { usage; return 2; }; bed=$2; shift 2 ;;
+      --session) [[ $# -ge 2 ]] || { usage; return 2; }; session=$2; shift 2 ;;
+      --cause) [[ $# -ge 2 ]] || { usage; return 2; }; cause=$2; shift 2 ;;
+      --fault) [[ $# -ge 2 ]] || { usage; return 2; }; fault=$2; shift 2 ;;
+      *) usage; return 2 ;;
+    esac
+  done
+  [[ "$bed" == /* && -d "$bed" && -n "$session" ]] || { usage; return 2; }
+  case "$cause" in arming|deadline) ;; *) usage; return 2 ;; esac
+  case "$fault" in none|hook-log|incident-state|both|engine) ;; *) usage; return 2 ;; esac
+
+  action_dir="$bed/artifacts/agents/fake-stop-replay"
+  seam_dir="$action_dir/deadline"
+  release_file="$action_dir/release"
+  wrapper="$action_dir/metasystem-wrapper"
+  engine="$bed/bin/metasystem"
+  mkdir -p "$seam_dir"
+  printf '%s\n' 1000000000 >"$seam_dir/started-epoch"
+  rm -f "$seam_dir/worker-blocked" "$release_file" "$action_dir/replay-calls.log"
+
+  case "$fault" in
+    hook-log)
+      mkdir -p "$bed/artifacts/agents/supervision/hooks.log"
+      ;;
+    incident-state)
+      mkdir -p "$bed/artifacts/agents/supervision"
+      printf '%s\n' 'refusal records unavailable' >"$bed/artifacts/agents/supervision/stop-refusals"
+      ;;
+    both)
+      mkdir -p "$bed/artifacts/agents/supervision/hooks.log"
+      printf '%s\n' 'refusal records unavailable' >"$bed/artifacts/agents/supervision/stop-refusals"
+      ;;
+  esac
+
+  if [[ "$fault" == engine ]]; then
+    wrapper="$action_dir/missing-metasystem"
+  else
+    cat >"$wrapper" <<'SH'
+#!/usr/bin/env bash
+set -euo pipefail
+printf '%s %s\n' "${1-}" "${2-}" >>"${METASYSTEM_FAKE_STOP_REPLAY_CALLS:?}"
+if [[ ${METASYSTEM_FAKE_STOP_REPLAY_CAUSE:?} == arming && ${1-} == up ]]; then
+  exit 64
+fi
+if [[ ${METASYSTEM_FAKE_STOP_REPLAY_CAUSE:?} == deadline &&
+      ${1-} == steward && ${2-} == hook-attempt &&
+      ! -e "${METASYSTEM_FAKE_STOP_REPLAY_SEAM:?}/worker-blocked" ]]; then
+  "${METASYSTEM_FAKE_STOP_REPLAY_ENGINE:?}" "$@"
+  : >"$METASYSTEM_FAKE_STOP_REPLAY_SEAM/worker-blocked"
+  hook_parent=$PPID
+  wait_started=$SECONDS
+  while [[ ! -e "${METASYSTEM_FAKE_STOP_REPLAY_RELEASE:?}" ]] &&
+      kill -0 "$hook_parent" 2>/dev/null && (( SECONDS - wait_started < 61 )); do
+    sleep 0.05
+  done
+  if [[ -e "$METASYSTEM_FAKE_STOP_REPLAY_RELEASE" ]] || ! kill -0 "$hook_parent" 2>/dev/null; then
+    exit 0
+  fi
+  echo "fake stop replay deadline wrapper exceeded its 61-second cap" >&2
+  exit 70
+fi
+exec "${METASYSTEM_FAKE_STOP_REPLAY_ENGINE:?}" "$@"
+SH
+    chmod +x "$wrapper"
+  fi
+
+  hook_config="$bed/scripts/enforcement/claude-code-hooks.json"
+  command_line=$(awk '
+    /"Stop"[[:space:]]*:/ { in_stop=1 }
+    in_stop && /"command"[[:space:]]*:/ { sub(/,[[:space:]]*$/, ""); print; exit }
+  ' "$hook_config")
+  [[ -n "$command_line" ]] || { echo "fake stop replay could not read the installed Stop command" >&2; return 1; }
+  stop_command=$("$engine" json get --value "{$command_line}" --field command --shell-safe) \
+    || { echo "fake stop replay could not decode the installed Stop command" >&2; return 1; }
+  payload=$(printf '{"session_id":"%s","cwd":"%s","hook_event_name":"Stop"}' "$session" "$bed")
+
+  trap ': >"$release_file"' RETURN
+  response=$(cd "$bed" && printf '%s\n' "$payload" |
+    METASYSTEM_BIN="$wrapper" \
+    METASYSTEM_DEADLINE_REAL_ENGINE="$engine" \
+    METASYSTEM_FAKE_STOP_REPLAY_ENGINE="$engine" \
+    METASYSTEM_FAKE_STOP_REPLAY_CAUSE="$cause" \
+    METASYSTEM_FAKE_STOP_REPLAY_CALLS="$action_dir/replay-calls.log" \
+    METASYSTEM_FAKE_STOP_REPLAY_SEAM="$seam_dir" \
+    METASYSTEM_FAKE_STOP_REPLAY_RELEASE="$release_file" \
+    METASYSTEM_STOP_DEADLINE_FIXTURE="$seam_dir" \
