{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned process census evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "writer", "verdict", "completedAt", "completedAtEpoch",
    "durationMs", "intervalSec", "fingerprint", "counts", "inventory",
    "diagnostics", "errors"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "writer": {"type": "string"},
    "verdict": {"enum": ["SUCCESS", "CENSUS-FAILED"]},
    "completedAt": {"type": "string", "format": "date-time"},
    "completedAtEpoch": {"type": "integer"},
    "durationMs": {"type": "integer", "minimum": 0},
    "intervalSec": {"type": "integer", "minimum": 1},
    "fingerprint": {"type": "string"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CUSTODY", "ANNOUNCED", "UNTRACKED"],
      "properties": {
        "CUSTODY": {"type": "integer", "minimum": 0},
        "ANNOUNCED": {"type": "integer", "minimum": 0},
        "UNTRACKED": {"type": "integer", "minimum": 0}
      }
    },
    "inventory": {"type": "array"},
    "diagnostics": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
