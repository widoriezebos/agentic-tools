{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "harness.version=1",
  "title": "Investigator return",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobId", "round", "runtime", "sessionId", "model", "evidence", "gaps", "mode", "frozenFrame", "theories", "classifications", "stopLoss"],
  "properties": {
    "jobId": {"type": "string"},
    "round": {"type": "integer"},
    "runtime": {"type": "string"},
    "sessionId": {"type": ["string", "null"]},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "effective"],
      "properties": {
        "requested": {"type": "string"},
        "effective": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "observed", "level"],
        "properties": {
          "command": {"type": "string"},
          "observed": {"type": "string"},
          "level": {"enum": ["ran", "read", "inferred"]}
        }
      }
    },
    "gaps": {"type": "array", "items": {"type": "string"}},
    "mode": {"type": "string"},
    "frozenFrame": {"type": "string"},
    "theories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "evidenceFor", "evidenceAgainst"],
        "properties": {
          "statement": {"type": "string"},
          "evidenceFor": {"type": "string"},
          "evidenceAgainst": {"type": "string"}
        }
      }
    },
    "classifications": {"type": "array", "items": {"type": "string"}},
    "stopLoss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggered", "trigger"],
      "properties": {
        "triggered": {"type": "boolean"},
        "trigger": {"type": ["string", "null"]}
      }
    }
  }
}
